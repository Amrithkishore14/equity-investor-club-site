{
  "name": "equity-investor-club",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_ADMIN", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["30 11 * * *", "30 12 * * *", "0 3 * * SUN"] },
  "observability": { "enabled": true },
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true }
}
